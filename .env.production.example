# ============================================================
# CotizaPro — Production Environment Variables Template
# ============================================================
# Copy this file to .env.production and fill in real values
# This file IS safe to commit (no secrets)
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe (use sk_test_ for sandbox, sk_live_ for production)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...
STRIPE_PRICE_ID_FREE=
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# App
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NODE_ENV=production

# Cron protection
CRON_SECRET=random_secret_here

# Cobro con Mercado Pago (D2): ligas de suscripción creadas a mano en el panel de Mercado Pago.
# Solo https; cualquier otro valor se ignora. Sin la variable, el plan se muestra como "Próximamente".
MP_LINK_STARTER=
MP_LINK_PRO=
MP_LINK_ENTERPRISE=
# WhatsApp de soporte para cuentas con más usuarios que los incluidos (10 dígitos o con 52)
SUPPORT_WHATSAPP_PHONE=
# Límites por plan programados pero apagados durante el piloto; solo el valor 'true' los enciende
PLAN_LIMITS_ENFORCED=false
# CRON_SECRET: mínimo 32 caracteres. Su sha256 también se guarda en platform_settings (ver docs/CRON_SETUP.md)
